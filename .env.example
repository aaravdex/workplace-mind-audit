# ──────────────────────────────────────────────────────────────────────────────
# Workplace Mind Audit — environment variables
#
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Only NEXT_PUBLIC_* variables are exposed to the browser; everything else is
# server-only. Values shown are placeholders/safe defaults.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used to build survey + report links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase (Phase 3+) ───────────────────────────────────────────────────────
# Project URL and anon key are public-by-design (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key bypasses RLS — SERVER ONLY, never expose to the browser.
# Used sparingly for trusted server actions (e.g. anonymous response inserts).
SUPABASE_SERVICE_ROLE_KEY=""

# ── Email — Resend (Phase 2+) ─────────────────────────────────────────────────
# Abstracted behind lib/email.ts. If RESEND_API_KEY is empty, email is logged
# to the console (dev stub) instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Workplace Mind Audit <reports@example.com>"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Public service pricing on/off (Services page shows prices when "true").
NEXT_PUBLIC_ENABLE_PUBLIC_PRICING="false"
# Payments subsystem (Phase 8). Kept off so launch is never blocked on billing.
ENABLE_PAYMENTS="false"

# ── Stripe (Phase 8 — only needed when ENABLE_PAYMENTS=true) ───────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Contact page (shows an honest "coming soon" state until set) ───────────────
CONTACT_EMAIL=""
BOOKING_URL=""

# ── Abuse protection ──────────────────────────────────────────────────────────
# Salt for transiently hashing caller IPs used ONLY as rate-limit keys (never
# stored on any row). Set to any long random string in production.
RATE_LIMIT_SALT=""
